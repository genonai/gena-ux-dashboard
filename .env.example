# 이 파일을 복사해 이름을 .env 로 바꾼 뒤 값을 채우세요.

# Amplitude 자동 갱신 (Amplitude > Settings > Projects > 해당 프로젝트에서 확인)
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
# EU 데이터센터를 쓰면 eu
AMPLITUDE_REGION=us

# 외부 공유(터널)용 비밀번호. 넣으면 모든 접속에 비밀번호를 묻습니다.
# APP_PASSWORD=

# 보기 전용 클라우드 사본(Cloudflare Pages) 프로젝트 이름과, 매주 갱신 뒤 자동 올리기(기본 꺼짐, on으로 켬)
# PAGES_PROJECT=ux-kpi-dashboard
# PUBLISH=on

# 선택 항목
# PORT=4321
# 사내망 팀원과 함께 쓰려면 0.0.0.0 (APP_PASSWORD도 함께 넣으세요. 없으면 접속한 누구나 수정할 수 있습니다)
# HOST=127.0.0.1
# AI 해석에 쓸 Claude Code 모델 (opus, sonnet 등)
# CLAUDE_MODEL=opus
# 자동 갱신 요일(0=일 … 3=수 … 6=토)과 시각(0~23). 기본은 수요일 오전 10시
# REFRESH_DAY=3
# REFRESH_HOUR=10
# 매주 자동 갱신을 끄려면 off
# AUTO_REFRESH=on

# 사용량 절감 (자세한 내용은 README의 "설정(.env)과 Claude 사용량")
# BACKFILL=off            이전 기간 채우기 끄기(켜면 한 번에 최대 약 100회)
# REUSE_ANALYSIS=on       값이 거의 같으면 직전 AI 해석을 이어 쓰기(기본 켜짐)
# RETRY_MAX=3             실패한 차트만 다시 받는 횟수(RETRY_EVERY_MIN=60분 간격)
# CLAUDE_EFFORT=          해석의 생각 수준(low|medium|high|max). 비우면 Claude Code 기본
# CLAUDE_COPY_MODEL=sonnet   haiku로 낮추면 더 싸지만, 정의를 틀리게 옮기면 CLAUDE_COPY_FALLBACK(sonnet)으로 한 번 더 시도
# KEEP_SNAPSHOTS=26       차트마다 남길 저장본 수(0이면 안 지움, 개선 트래커에 연결된 것은 늘 보존)
# SKIP_ANALYZE_BELOW=10   분모가 이 값 미만인 지표는 AI 해석·종합 진단에서 뺀다(0이면 끔, 메인 KPI는 늘 해석)
